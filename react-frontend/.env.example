# Copy to .env.local: cp .env.example .env.local

# API base URL. Locally the backend runs on :5001. On the portfolio deployment use "/api": Vercel
# proxies it to the backend (see vercel.json), so the refresh cookie stays first-party.
VITE_API_URL=http://localhost:5001/api

# Where the Vue analytics remote is served (its build must exist: pnpm --filter vue-analytics build).
VITE_VUE_ANALYTICS_URL=http://localhost:5174

# Portfolio deployment (docs/deployment.md): "Try the demo" button, no exports/uploads/registration.
# Build-time value; the backend has its own switch (IS_FOR_PORTFOLIO).
# VITE_IS_FOR_PORTFOLIO=true
