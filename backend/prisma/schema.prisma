datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum QuestionType {
  TEXT
  CHOICE_SINGLE
  CHOICE_MULTI
  BOOLEAN
  DATE
  NUMBER
  RATING
  SCALE
  NPS
  RANKING
  MATRIX
}

enum ResponseMode {
  ALL_AT_ONCE
  STEP_BY_STEP
}

model User {
  id        String      @id @default(uuid())
  email     String      @unique
  password  String
  forms     Form[]
  exportJobs ExportJob[]
  refreshTokens RefreshToken[]
  createdAt DateTime    @default(now())
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Form {
  id          String      @id @default(uuid())
  title       String
  description String?
  user        User        @relation(fields: [userId], references: [id])
  userId      String

  questions   Question[]
  responses   Response[]
  exportJobs  ExportJob[]
  attempts    ResponseAttempt[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now())

  // Counter for optimistic locking: updateForm increments it by 1 and accepts changes
  // only from a client that edited the current version. Without it two open editors would
  // silently overwrite each other (last write wins).
  version     Int         @default(1)

  isPublished Boolean     @default(false)
  shareId     String      @unique @default(uuid())

  responseMode ResponseMode @default(ALL_AT_ONCE)

  // Language of title/description/questions (the form's own fields). This is the "main"
  // language: its text is not stored as a translation, it is read from these fields.
  defaultLanguage String   @default("uk")
  // Additional languages (without the main one); translations holds one entry per language.
  languages       String[] @default([])
  // { [language]: { title?, description? } }, see FormTranslations in shared-types.
  translations    Json?

  @@index([userId])
}

model Question {
  id          String   @id @default(uuid())
  text        String
  description String?
  type        QuestionType
  required    Boolean  @default(false)

  options     Json?
  config       Json?
  condition   Json?

  // { [language]: { text?, description?, options?, rows?, minLabel?, maxLabel? } },
  // see QuestionTranslations in shared-types.
  translations Json?

  formId      String
  form        Form     @relation(fields: [formId], references: [id], onDelete: Cascade)

  order       Int

  @@index([formId])
}

model Response {
  id        String   @id @default(uuid())

  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId    String

  answers   Json
  // Questions that were actually shown to the respondent (computed by the server from each
  // question's condition and the submitted answers; the client is not trusted, so hidden
  // answers cannot be forged). Analytics uses it to tell "hidden by a condition" from
  // "shown but skipped".
  visibleQuestionIds Json?

  // Form language (from form.defaultLanguage/languages) the respondent filled it in;
  // null means unknown (responses from before languages existed, or an unrecognized language).
  language  String?

  createdAt DateTime @default(now())

  // Covers both the paged list (ORDER BY createdAt DESC) and the analytics keyset walk
  // (ORDER BY createdAt, id) within a form; the formId prefix replaces a separate formId index.
  @@index([formId, createdAt, id])
}

/**
 * A "draft" of a form session: an autosaved snapshot of the respondent's progress BEFORE
 * the final submit. Unlike Response (created only on a successful full submit), it also
 * exists for abandoned sessions, which is what makes the REAL funnel possible (how many
 * respondents reached each question, including those who never finished) instead of only
 * "branch popularity among completed responses" (what /analytics/paths does from Response).
 *
 * sessionKey is a client UUID generated in the respondent's browser on the first touch
 * (sessionStorage: survives a page reload in the same tab but not a new tab, on purpose:
 * a new tab is a new "visit" for the funnel). The same key is sent with the final submit
 * (submitResponse) to mark the attempt as completedAt; the server upserts by
 * (formId, sessionKey), so it does not create a row per keystroke.
 */
model ResponseAttempt {
  id     String @id @default(uuid())
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId String

  sessionKey String

  answers Json
  // Same meaning and computation as Response.visibleQuestionIds (resolveVisibleQuestionIds
  // from @quorvia/condition-engine).
  visibleQuestionIds Json?
  // "Reached": questions the respondent really saw at least once in this session. Unlike
  // visibleQuestionIds ("logically visible right now") it only grows: if the respondent goes
  // back and changes an answer so that a question gets hidden, it stays reached. The funnel
  // computes reachedCount from it. Updated atomically as a SQL union (see attempt.sql.ts).
  // null for rows created before the column existed (the funnel then falls back to
  // visibleQuestionIds).
  reachedQuestionIds Json?

  startedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // null = not finished yet (still filling in or abandoned). The funnel does not try to tell
  // these apart with a time threshold, which would be an arbitrary assumption; reports show
  // raw numbers.
  completedAt DateTime?

  @@unique([formId, sessionKey])
  // For cleanup (maintenance.service): abandoned attempts are deleted by startedAt. NOT
  // updatedAt on purpose: it changes on every autosave, and an index on it would defeat
  // HOT updates on the hottest table.
  @@index([startedAt])
  // @@index([formId]) was dropped: the unique (formId, sessionKey) index fully covers it
  // and also serves the funnel keyset walk.
}

enum ExportFormat {
  CSV
  EXCEL
  PDF
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ExportJob {
  id          String       @id @default(uuid())

  form        Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId      String

  user        User         @relation(fields: [userId], references: [id])
  userId      String

  format      ExportFormat
  status      ExportStatus @default(PENDING)

  filePath    String?
  fileName    String?

  responseCount Int?

  error       String?

  createdAt   DateTime     @default(now())
  completedAt DateTime?

  @@index([formId])
  @@index([userId])
  @@index([createdAt])
}
