datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum QuestionType {
  TEXT
  CHOICE_SINGLE
  CHOICE_MULTI
  BOOLEAN
  DATE
  NUMBER
}

enum ResponseMode {
  ALL_AT_ONCE
  STEP_BY_STEP
}

model User {
  id        String      @id @default(uuid())
  email     String      @unique
  password  String
  forms     Form[]
  exportJobs ExportJob[]
  refreshTokens RefreshToken[]
  createdAt DateTime    @default(now())
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Form {
  id          String      @id @default(uuid())
  title       String
  description String?
  user        User        @relation(fields: [userId], references: [id])
  userId      String

  questions   Question[]
  responses   Response[]
  exportJobs  ExportJob[]
  attempts    ResponseAttempt[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now())

  // Лічильник для optimistic locking: updateForm збільшує його на 1 і
  // приймає зміни лише від клієнта, що редагував актуальну версію. Без
  // цього два відкриті редактори тихо затирали б зміни один одного
  // (last write wins).
  version     Int         @default(1)

  isPublished Boolean     @default(false)
  shareId     String      @unique @default(uuid())

  responseMode ResponseMode @default(ALL_AT_ONCE)

  @@index([userId])
}

model Question {
  id          String   @id @default(uuid())
  text        String
  description String?
  type        QuestionType
  required    Boolean  @default(false)

  options     Json?
  config       Json?
  condition   Json?

  formId      String
  form        Form     @relation(fields: [formId], references: [id], onDelete: Cascade)

  order       Int

  @@index([formId])
}

model Response {
  id        String   @id @default(uuid())

  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId    String

  answers   Json
  // Питання, які фактично були показані користувачу під час проходження
  // (обчислюється сервером на основі condition кожного питання й наданих
  // відповідей — не покладаємось на клієнта, щоб не можна було підробити
  // приховані відповіді). Використовується аналітикою для розрізнення
  // "приховано умовою" vs "показано, але пропущено".
  visibleQuestionIds Json?

  createdAt DateTime @default(now())

  // Покриває і сторінковий список (ORDER BY createdAt DESC), і keyset-обхід
  // аналітики (ORDER BY createdAt, id) в межах форми; префікс formId замінює
  // окремий індекс по formId.
  @@index([formId, createdAt, id])
}

/**
 * "Чернетка" проходження форми - autosave-знімок прогресу респондента ДО
 * фінального сабміту. На відміну від Response (створюється лише при
 * успішному повному сабміті), цей запис існує і для покинутих проходжень -
 * саме це і дає змогу порахувати СПРАВЖНІЙ funnel (скільки респондентів
 * реально дійшли до кожного питання, включно з тими, хто так і не
 * завершив), а не лише "популярність гілок серед завершених" (те, що вже
 * робить /analytics/paths на основі Response).
 *
 * sessionKey - клієнтський UUID, згенерований у браузері респондента при
 * першому дотику до форми (react-frontend, sessionStorage, переживає
 * оновлення сторінки в межах тієї самої вкладки, але не нову вкладку -
 * свідомо: нова вкладка = новий "заход" для funnel-цілей). Той самий ключ
 * передається у фінальний сабміт (submitResponse), щоб позначити attempt
 * як completedAt - server-side upsert по (formId, sessionKey), не
 * плодить рядки на кожен keystroke.
 */
model ResponseAttempt {
  id     String @id @default(uuid())
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId String

  sessionKey String

  answers Json
  // Той самий сенс і те саме обчислення, що й Response.visibleQuestionIds
  // (resolveVisibleQuestionIds з @quorvia/condition-engine) - на
  // основі цього поля funnel рахує "найдальше досягнуте питання" навіть
  // для покинутих проходжень, з урахуванням conditional branching.
  visibleQuestionIds Json?
  // "Reached" - питання, які респондент реально побачив хоча б раз за це
  // проходження. На відміну від visibleQuestionIds ("зараз логічно
  // видиме") це множина, що лише росте: якщо респондент повернувся і
  // змінив відповідь, через що питання сховалось, воно лишається
  // досягнутим. Саме з цього поля funnel рахує reachedCount. Оновлюється
  // атомарно як об'єднання в SQL (див. attempt.sql.ts). null - рядки,
  // створені до появи колонки (funnel тоді падає на visibleQuestionIds).
  reachedQuestionIds Json?

  startedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // null = ще не завершено (або досі заповнює, або покинув - funnel не
  // намагається розрізнити ці два стани за жодним часовим порогом, це
  // було б довільним припущенням; звітність показує сирі цифри й дає
  // читачеві самому інтерпретувати).
  completedAt DateTime?

  @@unique([formId, sessionKey])
  // Для cleanup (maintenance.service): видалення покинутих проходжень за startedAt.
  // Навмисно НЕ updatedAt - він змінюється при кожному autosave, і індекс по ньому
  // гасив би HOT-оновлення на найгарячішій таблиці.
  @@index([startedAt])
  // @@index([formId]) прибрано: його повністю покриває унікальний індекс
  // (formId, sessionKey), який також обслуговує keyset-обхід funnel.
}

enum ExportFormat {
  CSV
  EXCEL
  PDF
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ExportJob {
  id          String       @id @default(uuid())

  form        Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId      String

  user        User         @relation(fields: [userId], references: [id])
  userId      String

  format      ExportFormat
  status      ExportStatus @default(PENDING)

  filePath    String?
  fileName    String?

  responseCount Int?

  error       String?

  createdAt   DateTime     @default(now())
  completedAt DateTime?

  @@index([formId])
  @@index([userId])
  @@index([createdAt])
}
