# Скопіюй у .env: cp .env.example .env
# Значення за замовчуванням відповідають docker-compose.yml у корені репо
# (запусти `pnpm docker:up` перед першим стартом бекенду).

DATABASE_URL="postgresql://quorvia:quorvia@localhost:5433/quorvia"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-in-production"

# Порт API (за замовчуванням 5001)
# PORT=5001

# Origin(и) фронтенду для CORS - через кому, якщо їх кілька.
CORS_ORIGIN="http://localhost:5173"

# Кількість reverse proxy перед бекендом ("1" для одного nginx/Render/Railway).
# БЕЗ цього за проксі rate limit бачить IP проксі, а не користувача.
# Локально лишіть порожнім.
# TRUST_PROXY=1

# У production (NODE_ENV=production) бекенд НЕ СТАРТУЄ, якщо JWT_SECRET
# коротший за 32 символи, лишився значенням-прикладом або CORS_ORIGIN
# вказує на localhost. Згенерувати секрет: openssl rand -base64 48

# Прибирання даних (воркер, раз на добу):
# скільки днів зберігати готові експорти (файли в uploads/exports + записи) ...
# EXPORT_RETENTION_DAYS=7
# ... і незавершені проходження (autosave-чернетки). 0 = не видаляти.
# Видалення покинутих проходжень зменшує totalAttempts у funnel за старий період
# (completionRate для нього зросте) - див. README, "Data retention".
# ATTEMPT_RETENTION_DAYS=180
