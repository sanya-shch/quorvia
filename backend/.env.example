# Copy to .env: cp .env.example .env
# The defaults match docker-compose.yml in the repository root
# (run `pnpm docker:up` before the first backend start).

DATABASE_URL="postgresql://quorvia:quorvia@localhost:5433/quorvia"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-in-production"

# API port (default 5001)
# PORT=5001

# Frontend origin(s) for CORS, comma-separated if there are several.
CORS_ORIGIN="http://localhost:5173"

# Number of reverse proxies in front of the backend ("1" for one nginx/Render/Railway).
# Without it, behind a proxy the rate limit sees the proxy's IP, not the user's.
# Leave empty locally.
# TRUST_PROXY=1

# In production (NODE_ENV=production) the backend does NOT START if JWT_SECRET is
# shorter than 32 characters, is still the example value, or CORS_ORIGIN points
# to localhost. Generate a secret: openssl rand -base64 48

# Data cleanup (worker, once a day):
# how many days to keep finished exports (files in uploads/exports + rows) ...
# EXPORT_RETENTION_DAYS=7
# ... and unfinished sessions (autosave drafts). 0 = never delete.
# Deleting abandoned sessions lowers totalAttempts in the funnel for the old period
# (its completionRate goes up); see docs/security.md, "Data retention".
# ATTEMPT_RETENTION_DAYS=180
